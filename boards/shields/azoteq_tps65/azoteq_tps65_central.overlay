#include "azoteq_tps65.dtsi"

/*
 * TPS65 is physically connected to the LEFT / central half.
 *
 * OLED stays on the standard Pro Micro I2C bus:
 *   SDA D2 / P0.17
 *   SCL D3 / P0.20
 *
 * RGB stays on D1 / P0.06.
 *
 * TPS65 uses the nRF52840 second I2C controller:
 *   SDA D16 / P0.10
 *   SCL D10 / P0.09
 *   NRST D8 / P1.04
 *   RDY  D9 / P1.06
 */
&pinctrl {
    tps65_i2c_default: tps65_i2c_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 10)>,
                    <NRF_PSEL(TWIM_SCL, 0, 9)>;
        };
    };

    tps65_i2c_sleep: tps65_i2c_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 10)>,
                    <NRF_PSEL(TWIM_SCL, 0, 9)>;
            low-power-enable;
        };
    };
};

&i2c1 {
    compatible = "nordic,nrf-twi";
    status = "okay";
    pinctrl-0 = <&tps65_i2c_default>;
    pinctrl-1 = <&tps65_i2c_sleep>;
    pinctrl-names = "default", "sleep";

    tps65: iqs5xx@74 {
        status = "okay";
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;

        reset-gpios = <&pro_micro 8 GPIO_ACTIVE_LOW>;
        rdy-gpios = <&pro_micro 9 GPIO_ACTIVE_HIGH>;

        one-finger-tap;
        press-and-hold;
        press-and-hold-time = <250>;
        two-finger-tap;

        scroll;
        natural-scroll-y;
        natural-scroll-x;

        bottom-beta = <5>;
        stationary-threshold = <5>;

        switch-xy;
    };
};

&tps65_listener {
    status = "okay";
    device = <&tps65>;
};
