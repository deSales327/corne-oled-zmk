#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

/*
 * This build has only the 21 per-key SK6812 LEDs fitted on each half.
 * ZMK uses the RGB underglow subsystem for addressable per-key LEDs too.
 * Override the generic Corne default of 10 LEDs per half.
 */
&led_strip {
        chain-length = <21>;
};

/ {
        macros {
                alt_tab_layer: alt_tab_layer {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        display-name = "Alt-Tab Layer";
                        wait-ms = <0>;
                        tap-ms = <0>;

                        bindings =
                                <&macro_press &mo 1 &kp LALT>,
                                <&macro_pause_for_release>,
                                <&macro_release &mo 1 &kp LALT>;
                };

                rgb_force_on: rgb_force_on {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        display-name = "Force RGB On";
                        wait-ms = <30>;
                        tap-ms = <30>;

                        /* Enable the nice!nano external VCC domain, turn RGB on,
                         * then force a steady full-brightness red value. Both
                         * power and RGB behaviors are global on split keyboards. */
                        bindings =
                                <&macro_tap &ext_power EP_ON>,
                                <&macro_tap &rgb_ug RGB_ON>,
                                <&macro_tap &rgb_ug RGB_COLOR_HSB(0,100,100)>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | ALT+L1 | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &alt_tab_layer &kp SPACE   &kp RET &mo 2 &kp RALT
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | EPON |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
   &ext_power EP_ON  &trans  &trans  &trans  &trans  &trans         &trans   &trans   &trans &trans    &trans &trans
                                    &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT | EPON|FORCE| RGB+| BRI- | BRI+|   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &ext_power EP_ON &rgb_force_on &rgb_ug RGB_ON &rgb_ug RGB_BRD &rgb_ug RGB_BRI      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                             &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };
        };
};
